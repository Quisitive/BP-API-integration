{
  "name": "bp-api-integration",
  "version": "2.0.0",
  "type": "module",
  "description": "Unified SOC Command Dashboard — Blackpoint + Microsoft Defender XDR Integration",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dashboard": "npm run dev",
    "dev:client": "vite",
    "dev:server": "tsx watch src/backend/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/backend/server.js",
    "preview": "vite preview",
    "test": "tsx --test src/backend/services/tuningInsights.test.ts src/backend/services/correlationTrends.test.ts src/backend/services/snapshotAnomalies.test.ts src/backend/services/correlationCandidates.test.ts src/backend/services/tuningTickets.test.ts src/backend/services/cisoReport.test.ts src/backend/storage/file.test.ts",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "legacy:dev": "ts-node --project tsconfig.legacy.json legacy/examples/soc-workflow-complete.ts",
    "legacy:serve": "node server.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.27.0",
    "@azure/msal-node": "^5.4.0",
    "@azure/msal-react": "^2.1.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "bp-api-integration": "file:",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
